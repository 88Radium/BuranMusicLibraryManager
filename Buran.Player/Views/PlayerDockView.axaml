<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Buran.Player.ViewModels"
             xmlns:models="using:Buran.Player.Models"
             xmlns:loc="using:Buran.Localization"
             x:Class="Buran.Player.Views.PlayerDockView"
             x:DataType="vm:PlayerTabViewModel"
             x:CompileBindings="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="ChromeHost" MinHeight="140" MinWidth="160" />

        <Button Grid.Column="1" Width="36" Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                VerticalAlignment="Stretch"
                Command="{Binding TogglePlaylistPanelCommand}"
                ToolTip.Tip="{loc:Loc Key=Player.Playlists}">
            <LayoutTransformControl>
                <LayoutTransformControl.LayoutTransform>
                    <RotateTransform Angle="-90" />
                </LayoutTransformControl.LayoutTransform>
                <TextBlock Text="{loc:Loc Key=Player.Playlist}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </LayoutTransformControl>
        </Button>

        <Grid Grid.Column="2" Width="{Binding PlaylistPanelWidth}" MinWidth="160"
              IsVisible="{Binding IsPlaylistOpen}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PlaylistResizeThumb"
                    Background="#3A4F70"
                    Cursor="SizeWestEast"
                    PointerPressed="PlaylistSplitter_PointerPressed"
                    PointerMoved="PlaylistSplitter_PointerMoved"
                    PointerReleased="PlaylistSplitter_PointerReleased"
                    PointerCaptureLost="PlaylistSplitter_PointerCaptureLost" />
            <Border Grid.Column="1" Classes="toolbar" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Playlists}"
                              SelectedItem="{Binding SelectedPlaylist}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox PlaceholderText="{loc:Loc Key=Player.PlaylistName}"
                             Text="{Binding SelectedPlaylistName}"
                             IsEnabled="{Binding HasPlaylists}" />
                    <WrapPanel>
                        <Button Margin="0,0,6,6" Content="{loc:Loc Key=Player.NewPlaylist}" Command="{Binding NewPlaylistCommand}" />
                        <Button Margin="0,0,6,6" Content="{loc:Loc Key=Player.DeletePlaylist}" Command="{Binding DeletePlaylistCommand}"
                                IsEnabled="{Binding HasPlaylists}" />
                        <Button Margin="0,0,6,6" Content="{loc:Loc Key=Player.ImportM3u}" Command="{Binding ImportM3uCommand}" />
                        <Button Margin="0,0,6,6" Content="{loc:Loc Key=Player.ExportM3u}" Command="{Binding ExportM3uCommand}"
                                IsEnabled="{Binding HasPlaylistTracks}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Key=Common.Remove}"
                            Command="{Binding RemovePlaylistTrackCommand}"
                            IsEnabled="{Binding SelectedPlaylistTrack, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding PlaylistTracks}"
                         SelectedItem="{Binding SelectedPlaylistTrack}"
                         DoubleTapped="PlaylistTracks_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistTrack">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding DurationText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
