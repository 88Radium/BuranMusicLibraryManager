<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Buran.Player.ViewModels"
             xmlns:controls="using:Buran.Player.Controls"
             xmlns:loc="using:Buran.Localization"
             x:Class="Buran.Player.Views.PlayerChrome"
             x:DataType="vm:PlayerTabViewModel"
             x:CompileBindings="True">
    <Grid RowDefinitions="Auto,*">
        <Border Classes="toolbar" Padding="8,4">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Width="32" Height="26" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding PlayPreviousCommand}"
                                ToolTip.Tip="{loc:Loc Key=Player.Previous}">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#E8EEF8"
                                  Data="M 2,1 H 4.2 V 13 H 2 Z M 5,7 L 13,1 V 13 Z" />
                        </Button>
                        <Button Width="36" Height="26" Padding="0" Classes="accent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding PlayPauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseLabel}">
                            <Panel Width="14" Height="14">
                                <Path IsVisible="{Binding !IsPlaying}" Stretch="Uniform"
                                      Fill="#E8EEF8" Data="M 1,1 L 13,7 L 1,13 Z" />
                                <Path IsVisible="{Binding IsPlaying}" Stretch="Uniform"
                                      Fill="#E8EEF8" Data="M 1,1 H 5 V 13 H 1 Z M 9,1 H 13 V 13 H 9 Z" />
                            </Panel>
                        </Button>
                        <Button Width="32" Height="26" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding StopCommand}"
                                ToolTip.Tip="{loc:Loc Key=Player.Stop}">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="#E8EEF8"
                                  Data="M 1,1 H 13 V 13 H 1 Z" />
                        </Button>
                        <Button Width="32" Height="26" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding PlayNextCommand}"
                                ToolTip.Tip="{loc:Loc Key=Player.Next}">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="#E8EEF8"
                                  Data="M 1,1 L 9,7 L 1,13 Z M 10,1 H 13 V 13 H 10 Z" />
                        </Button>
                        <Button Width="32" Height="26" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding CycleRepeatModeCommand}"
                                ToolTip.Tip="{Binding RepeatModeTip}">
                            <Panel Width="16" Height="16">
                                <Path IsVisible="{Binding IsRepeatOff}" Stretch="Uniform"
                                      Stroke="#9AA8BC" StrokeThickness="1.5" StrokeLineCap="Round"
                                      Data="M 3,6 H 10 L 8.2,4.4 M 10,6 L 8.2,7.6 M 13,10 H 6 L 7.8,8.4 M 6,10 L 7.8,11.6 M 3,13 L 13,3" />
                                <Path IsVisible="{Binding IsRepeatAll}" Stretch="Uniform"
                                      Stroke="#5EC8F0" StrokeThickness="1.5" StrokeLineCap="Round"
                                      Data="M 3,6 H 10 L 8.2,4.4 M 10,6 L 8.2,7.6 M 13,10 H 6 L 7.8,8.4 M 6,10 L 7.8,11.6" />
                                <Panel IsVisible="{Binding IsRepeatOne}">
                                    <Path Stretch="Uniform"
                                          Stroke="#5EC8F0" StrokeThickness="1.5" StrokeLineCap="Round"
                                          Data="M 2,5 H 8 L 6.5,3.6 M 8,5 L 6.5,6.4 M 11,9 H 5 L 6.5,7.6 M 5,9 L 6.5,10.4" />
                                    <TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="#5EC8F0"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Panel>
                                <Path IsVisible="{Binding IsPlayOnce}" Stretch="Uniform" Fill="#5EC8F0"
                                      Data="M 1,2 L 9,8 L 1,14 Z M 11.2,3 H 14 V 13 H 11.2 Z" />
                            </Panel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding NowPlaying.DisplayTitle, FallbackValue=''}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="muted"
                               Text="{Binding PositionText}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{loc:Loc Key=Player.Volume}" Classes="muted" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="100" Width="88"
                                Value="{Binding Volume}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Classes="muted"
                           Text="{Binding StatusText}"
                           IsVisible="{Binding HasStatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusText}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="toolbar" Padding="2" ClipToBounds="True">
            <controls:SpectrogramControl HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Source="{Binding SpectrogramImage}"
                                         Position="{Binding Position}"
                                         DurationSeconds="{Binding DurationSeconds}"
                                         NyquistHz="{Binding NyquistHz}"
                                         SeekRequested="Spectrogram_SeekRequested" />
        </Border>
    </Grid>
</UserControl>
