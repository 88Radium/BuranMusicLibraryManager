<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BuranUI.ViewModels"
        xmlns:models="using:BuranUI.Models"
        xmlns:loc="using:Buran.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="1400"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        x:Class="BuranUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Buran.ico"
        Opacity="{Binding WindowOpacity}"
        TransparencyLevelHint="Transparent"
        Background="#CC0B1220"
        Title="Buran">
    <!-- x:DataType="vm:MainWindowViewModel" -->
    <!-- xmlns:local="clr-namespace:BuranUI.ViewModels" -->
    
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        
        <vm:MainWindowViewModel />
    </Design.DataContext>


    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="app-header">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="app-title" Text="BURAN" />
                    <TextBlock Classes="app-subtitle" Text="{loc:Loc Key=Main.Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost"
                        Content="{loc:Loc Key=Settings.Title}"
                        ToolTip.Tip="{loc:Loc Key=Settings.OpenTip}"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="280" Spacing="14" Margin="4">
                                <TextBlock Classes="sidebar-heading" Text="{loc:Loc Key=Settings.Title}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc Key=Language.Label}" Classes="muted" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedItem="{Binding SelectedLanguage}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="loc:LanguageOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc Key=Settings.FontSize}" Classes="muted" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontSizeOptions}"
                                              SelectedItem="{Binding SelectedFontSize}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:FontSizeOption">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:Loc Key=Main.Transparency}" Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="muted"
                                                   Text="{Binding WindowOpacity, StringFormat='{}{0:P0}'}" />
                                    </Grid>
                                    <Slider Minimum="0.4" Maximum="1" TickFrequency="0.05"
                                            Value="{Binding WindowOpacity}"
                                            ToolTip.Tip="{loc:Loc Key=Main.TransparencyTip}" />
                                </StackPanel>

                                <Button Classes="ghost" HorizontalAlignment="Stretch"
                                        Content="{loc:Loc Key=Help.Open}"
                                        ToolTip.Tip="{loc:Loc Key=Help.OpenTip}"
                                        Command="{Binding OpenHelpCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="280,6,*">
            <Border Grid.Column="0" Classes="sidebar"
                    DataContext="{Binding Library}">
                <DockPanel x:DataType="vm:LibraryBrowserViewModel">
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Classes="sidebar-heading" Text="{loc:Loc Key=Library.Heading}" />
                        <TextBlock Classes="path" Text="{Binding LibraryRootDisplay}"
                                   ToolTip.Tip="{Binding LibraryRootsTooltip}" />
                        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                            <Button Classes="accent" Content="{loc:Loc Key=Library.AddFolder}"
                                    Command="{Binding ChooseLibraryRootCommand}"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Classes="ghost" Content="{loc:Loc Key=Library.RemoveFolder}"
                                    Command="{Binding RemoveLibraryRootCommand}"
                                    IsEnabled="{Binding CanRemoveLibraryRoot}"
                                    ToolTip.Tip="{loc:Loc Key=Library.RemoveFolderTip}" />
                            <Button Grid.Column="4" Classes="ghost" Content="{loc:Loc Key=Library.Refresh}"
                                    Command="{Binding RefreshLibraryCommand}"
                                    IsEnabled="{Binding HasLibraryRoot}" />
                        </Grid>
                        <CheckBox Content="{loc:Loc Key=Library.IncludeSubfolders}"
                                  IsChecked="{Binding IncludeSubfolders}"
                                  IsEnabled="{Binding HasLibraryRoot}" />
                        <Button Classes="ghost" Content="{loc:Loc Key=Library.IndexLibrary}"
                                Command="{Binding IndexLibraryCommand}"
                                IsEnabled="{Binding HasLibraryRoot}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,8,0,0"
                               Text="{Binding CurrentFolderDisplay}"
                               TextTrimming="CharacterEllipsis" />

                    <Panel>
                        <TreeView Classes="library-tree"
                                  ItemsSource="{Binding FolderNodes}"
                                  SelectedItem="{Binding SelectedFolder}"
                                  IsVisible="{Binding HasLibraryRoot}">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Key=Library.RemoveFolder}"
                                              Command="{Binding RemoveLibraryRootCommand}"
                                              IsEnabled="{Binding CanRemoveLibraryRoot}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="models:FolderNode"
                                                  ItemsSource="{Binding Children}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="audio-dot"
                                                IsVisible="{Binding HasAudioFiles}" />
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6" IsVisible="{Binding !HasLibraryRoot}">
                            <TextBlock Text="{loc:Loc Key=Library.NoLibrary}" Classes="empty-title" Opacity="0.7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Width="200"
                                       Text="{loc:Loc Key=Library.NoLibraryHint}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="2" Classes="workspace">
                <Grid x:Name="WorkspaceGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7*" MinHeight="120" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="3*" MinHeight="160" />
                    </Grid.RowDefinitions>
                    <TabControl x:Name="MainTabControl" Classes="folder-tabs" Grid.Row="0" />
                    <GridSplitter x:Name="PlayerSplitter" Grid.Row="1"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#3A4F70" />
                    <DockPanel x:Name="PlayerBarHost" Grid.Row="2">
                        <Button DockPanel.Dock="Right" Classes="ghost" Width="36"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding SwapPlayerAndTabsCommand}"
                                ToolTip.Tip="{loc:Loc Key=Player.SwapLayout}"
                                Content="⇅" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>