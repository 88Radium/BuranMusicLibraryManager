<Project>
  <!-- MEF plugins must keep their own bin/ so Rider can resolve generated commands in XAML.
       After build, copy plugin assemblies (and their NuGet DLLs) into the host output. -->
  <Target Name="CopyPluginToHost" AfterTargets="Build">
    <PropertyGroup>
      <_HostOut>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)BuranUI/bin/$(Configuration)/$(TargetFramework)'))'))</_HostOut>
    </PropertyGroup>
    <MakeDir Directories="$(_HostOut)" />
    <ItemGroup>
      <_PluginCopy Include="$(TargetDir)*.dll" />
      <_PluginCopy Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginCopy)" DestinationFolder="$(_HostOut)" SkipUnchangedFiles="true" />
  </Target>
</Project>
