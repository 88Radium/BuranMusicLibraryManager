<Project>
  <!-- MEF plugins keep their own bin/ so Rider can resolve generated XAML commands.
       After a real build (not design-time), copy plugin DLLs next to BuranUI. -->
  <Target Name="CopyPluginToHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_RidSeg Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</_RidSeg>
      <_HostDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)BuranUI/bin/$(Configuration)/$(TargetFramework)/$(_RidSeg)'))</_HostDir>
    </PropertyGroup>
    <MakeDir Directories="$(_HostDir)" />
    <ItemGroup>
      <_PluginCopy Include="$(TargetDir)*.dll" />
      <_PluginCopy Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy Condition="'@(_PluginCopy)' != ''"
          SourceFiles="@(_PluginCopy)"
          DestinationFolder="$(_HostDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
