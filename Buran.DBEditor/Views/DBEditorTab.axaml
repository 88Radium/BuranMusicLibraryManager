<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="Buran.DBEditor.Views.DBEditorTab"
             xmlns:vm="using:Buran.DBEditor.ViewModels"
             xmlns:sqlite="using:Buran.SQLite"
             xmlns:models="using:Buran.DBEditor.Models"
             x:CompileBindings="True"
             x:DataType="vm:DBEditorTabViewModel">

    <UserControl.DataContext>
        <vm:DBEditorTabViewModel />
    </UserControl.DataContext>

    <Grid ColumnDefinitions="*,4,*,4,*,4,*" Margin="8">

        <!-- Künstler -->
        <DockPanel Grid.Column="0">
            <Label DockPanel.Dock="Top" Content="{Binding ArtistListCaption}" />
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,8,0,0">
                <TextBox Grid.Column="0" Watermark="Künstlername" Text="{Binding NewPreferredArtistName}" Margin="0,0,4,0" />
                <TextBox Grid.Column="1" Watermark="Bürgerlicher Name" Text="{Binding NewRealName}" />
            </Grid>
            <Button DockPanel.Dock="Bottom" Content="Künstler hinzufügen" Command="{Binding AddArtistCommand}" Margin="0,4,0,0" />
            <ListBox ItemsSource="{Binding FilteredArtistNames}" SelectedItem="{Binding SelectedArtistName}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Entfernen" Command="{Binding DeleteArtistCommand}" />
                        <MenuItem Header="Auswahl aufheben" Command="{Binding UnselectArtistCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sqlite:DatabaseTable_ArtistNames">
                        <Border Padding="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{Binding ID}" Opacity="0.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding PreferredArtistName}" Watermark="Künstlername" />
                                    <TextBox Text="{Binding RealName}" Watermark="Bürgerlicher Name" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

        <!-- Alternative Namen -->
        <DockPanel Grid.Column="2">
            <Label DockPanel.Dock="Top" Content="{Binding AlternativeListCaption}" />
            <TextBox DockPanel.Dock="Bottom" Watermark="Alternativer Name, z. B. Slim Shady"
                     Text="{Binding NewAlternativeName}" Margin="0,8,0,0"
                     IsEnabled="{Binding HasSelectedArtist}" />
            <Button DockPanel.Dock="Bottom" Content="Variante hinzufügen" Command="{Binding AddAlternativeCommand}" Margin="0,4,0,0" />
            <ListBox ItemsSource="{Binding FilteredAlternativeArtistNameVariants}" SelectedItem="{Binding SelectedAlternativeName}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Entfernen" Command="{Binding DeleteAlternativeCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sqlite:DatabaseTable_AlternativeArtistNameVariants">
                        <Border Padding="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="{Binding ID}" Opacity="0.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding AlternativeArtistName}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" />

        <!-- Genres -->
        <DockPanel Grid.Column="4">
            <Label DockPanel.Dock="Top" Content="Genres" />
            <TextBox DockPanel.Dock="Bottom" Watermark="Neues Genre" Text="{Binding NewGenreName}" Margin="0,8,0,0" />
            <Button DockPanel.Dock="Bottom" Content="Genre hinzufügen" Command="{Binding AddGenreCommand}" Margin="0,4,0,0" />
            <ListBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Entfernen" Command="{Binding DeleteGenreCommand}" />
                        <MenuItem Header="Auswahl aufheben" Command="{Binding UnselectGenreCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AssignableTag">
                        <DockPanel Margin="4">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsAssigned}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:DBEditorTabViewModel)DataContext).HasSelectedArtist}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="5" Width="4" ResizeDirection="Columns" />

        <!-- Moods -->
        <DockPanel Grid.Column="6">
            <Label DockPanel.Dock="Top" Content="Moods" />
            <TextBox DockPanel.Dock="Bottom" Watermark="Neues Mood" Text="{Binding NewMoodName}" Margin="0,8,0,0" />
            <Button DockPanel.Dock="Bottom" Content="Mood hinzufügen" Command="{Binding AddMoodCommand}" Margin="0,4,0,0" />
            <ListBox ItemsSource="{Binding Moods}" SelectedItem="{Binding SelectedMood}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Entfernen" Command="{Binding DeleteMoodCommand}" />
                        <MenuItem Header="Auswahl aufheben" Command="{Binding UnselectMoodCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AssignableTag">
                        <DockPanel Margin="4">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsAssigned}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:DBEditorTabViewModel)DataContext).HasSelectedArtist}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
