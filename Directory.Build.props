<Project>
  <PropertyGroup>
    <!-- Bump this, then push master: GitHub builds a new Release (RPM + Windows setup.exe). -->
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>0.1.2</InformationalVersion>
    <Product>Buran Music Library Manager</Product>
    <AssemblyTitle>Buran Music Library Manager</AssemblyTitle>
    <BuranRepoRoot>$(MSBuildThisFileDirectory)</BuranRepoRoot>
  </PropertyGroup>
</Project>
