<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Buran.ID3Editor.ViewModels"
        xmlns:types="using:Buran.ID3Editor.Types"
        xmlns:fileTypes="using:Buran.Types"
        xmlns:loc="using:Buran.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        Width="740" Height="580"
        MinWidth="560" MinHeight="420"
        x:Class="Buran.ID3Editor.Views.BulkCommentsWindow"
        x:DataType="vm:BulkCommentsViewModel"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button Classes="ghost" Content="{loc:Loc Key=Common.Cancel}" Command="{Binding CancelCommand}" />
            <Button Classes="accent" Content="{loc:Loc Key=Common.Apply}" Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}" />
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,*,Auto,*" RowSpacing="10">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Hint}" />

            <GroupBox Grid.Row="1" Header="{loc:Loc Key=Id3.Comment}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding NewComment}"
                             PlaceholderText="{loc:Loc Key=Bulk.CommentPlaceholder}" />
                    <Button Grid.Column="1" Content="{loc:Loc Key=Bulk.ClearComment}"
                            Command="{Binding ClearCommentCommand}"
                            VerticalAlignment="Top" />
                    <Button Grid.Column="2" Content="{loc:Loc Key=Bulk.LoadFromSelection}"
                            Command="{Binding LoadFromSelectionCommand}"
                            VerticalAlignment="Top" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="{loc:Loc Key=Bulk.SelectedFiles}">
                <ListBox ItemsSource="{Binding SelectedFiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="fileTypes:Mp3FileObject">
                            <TextBlock Text="{Binding FileName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <TextBlock Grid.Row="3" Classes="muted"
                       Text="{loc:Loc Key=Bulk.CommentsApplyHint}" />

            <GroupBox Grid.Row="4" Header="{loc:Loc Key=Common.Preview}">
                <ListBox ItemsSource="{Binding PreviewItems}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="types:TagPreviewItem">
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="muted" Text="{loc:Loc Key=Common.Previous}" />
                                    <TextBlock Classes="muted" Text="{Binding OldTags}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{loc:Loc Key=Common.New}" />
                                    <TextBlock Text="{Binding NewTags}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
