<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="650"
        x:Class="Buran.ID3Editor.Views.AddArtistToID3DialogWindow"
        x:CompileBindings="False"
        Title="Künstler zu ID3-Tags hinzufügen/entfernen"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        >
    
    <!-- xmlns:vm="using:Buran.ID3Editor.ViewModels" -->
    <!-- x:DataType="vm:AddArtistToID3DialogWindowViewModel" -->
    
    <!-- <Window.DataContext> -->
    <!--     <vm:AddArtistToID3DialogWindowViewModel/> -->
    <!-- </Window.DataContext> -->
    
    <Window.Resources>
        <!-- <BooleanToVisibilityConverter x:Key="BooleanVisConverter"/> -->
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- NEU: Für AutoComplete -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Aktuelle Künstler-Liste -->
        <GroupBox Grid.Row="0" Header="Aktuelle Künstler" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding CurrentArtists}" Height="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" 
                                        Content="X" 
                                        Margin="5,0,0,0" 
                                        Width="20"
                                        Command="{Binding DataContext.RemoveArtistCommand, 
                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <TextBlock Text="{Binding}" 
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Content="Alle löschen" 
                            Command="{Binding ClearAllArtistsCommand}"
                            Width="80" Margin="0,0,0,5"/>
                    <Button Content="Aus Datei laden" 
                            Command="{Binding LoadFromFileCommand}"
                            Width="80"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Eingabezeile -->
        <GroupBox Grid.Row="1" Header="Neuen Künstler hinzufügen" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <TextBox x:Name="ArtistTextBox"
                             Text="{Binding NewArtistInput, UpdateSourceTrigger=PropertyChanged}"
                             Width="300"
                             KeyDown="ArtistTextBox_KeyDown"/>

                    <Button Content="Hinzufügen" 
                            Command="{Binding AddArtistCommand}"
                            Margin="10,0,0,0" 
                            Width="80"
                            IsEnabled="{Binding CanAddArtist}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- AutoComplete Vorschläge (SEPARAT unterhalb) -->
        <Border Grid.Row="2" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                CornerRadius="3"
                Margin="0,0,0,10"
                Background="White"
                IsVisible="{Binding HasAutoCompleteItems}">
            <ListBox x:Name="AutoCompleteList"
                     ItemsSource="{Binding AutoCompleteItems}"
                     MaxHeight="150"
                     SelectedItem="{Binding SelectedAutoCompleteItem, Mode=TwoWay}"
                     DoubleTapped="AutoCompleteList_MouseDoubleClick"
                     SelectionChanged="AutoCompleteList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="5,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
                <!-- <ListBox.ItemContainerTheme> -->
                <!--     <Style TargetType="ListBoxItem"> -->
                <!--         <Setter Property="Padding" Value="0"/> -->
                <!--         <Style.Triggers> -->
                <!--             <Trigger Property="IsMouseOver" Value="True"> -->
                <!--                 <Setter Property="Background" Value="LightBlue"/> -->
                <!--             </Trigger> -->
                <!--         </Style.Triggers> -->
                <!--     </Style> -->
                <!-- </ListBox.ItemContainerTheme> -->
                
            </ListBox>
        </Border>

        <!-- Info-Text für neue Künstler (nur wenn KEINE AutoComplete-Items) -->
        <TextBlock Grid.Row="2" 
                   Text="Tipp: Gib einen neuen Namen ein und er wird automatisch in die Datenbank übernommen!"
                   FontStyle="Italic" 
                   Foreground="Gray"
                   Margin="0,5,0,10"
                   IsVisible="{Binding IsNewArtist}"
                   TextWrapping="Wrap"/>

        <!-- Ausgewählte Dateien -->
        <GroupBox Grid.Row="3" Header="Ausgewählte Dateien" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding SelectedFiles}" MaxHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FileName}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Vorschau -->
        <GroupBox Grid.Row="4" Header="Vorschau" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding PreviewItems}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5">
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bisher: " Foreground="Gray"/>
                                <TextBlock Text="{Binding OldArtists}" Foreground="Gray" FontStyle="Italic"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Neu: " Foreground="Green"/>
                                <TextBlock Text="{Binding NewArtists}" Foreground="Green" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" 
                    Command="{Binding CancelCommand}"
                    Width="80" 
                    Margin="0,0,10,0"/>
            <Button Content="Übernehmen" 
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}"
                    Width="100"/>
        </StackPanel>
    </Grid>
    
</Window>
