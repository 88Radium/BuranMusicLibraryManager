<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Buran.ID3Editor.Views.Id3EditorTab"
             xmlns:vm="using:Buran.ID3Editor.ViewModels"
             x:DataType="vm:Id3EditorTabViewModel"
             x:CompileBindings="True">

    <!-- ✅ WICHTIG: DataContext wird hier definiert, nicht im Code-Behind! -->
    <UserControl.DataContext>
        <vm:Id3EditorTabViewModel />
    </UserControl.DataContext>

    <Design.DataContext>
        <!-- Für Design-Time in der IDE -->
        <vm:Id3EditorTabViewModel />
    </Design.DataContext>

    <TabItem x:Name="Id3EditorTabControl" Header="ID3 Editor">

        <Grid x:Name="Id3EditorGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <StackPanel x:Name="OutsideStackPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <StackPanel x:Name="InsideStackPanel" Orientation="Vertical">
                    <TextBlock VerticalAlignment="Bottom" Text="Pfad der umzubenennenden Musikdateien:" />
                    <TextBox VerticalAlignment="Center" x:Name="DirPath" VerticalContentAlignment="Center" Text="{Binding SelectedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="DirPath_TextChanged" Height="20" />
                </StackPanel>
                <Button x:Name="BtnOfd" Content="Open directory" Command="{Binding OfdCommand}" VerticalAlignment="Bottom" Margin="5,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5" IsEnabled="{Binding HasMusicFiles}"> <!-- Visibility="{Binding HasMusicFiles, Converter={StaticResource BooleanVisConverter}, Mode=OneWay}" -->
                <TextBlock Text="{Binding SelectedFilesCount, StringFormat='{}Ausgewählt: {0}'}" />
                <Button Content="Künstler zu ID3-Tag hinzufügen" Margin="8,0,0,0"  Command="{Binding OpenAddArtistDialogCommand}" />
            </StackPanel>

            <ListBox x:Name="ItemsListView" Grid.Row="2"
                     ItemsSource="{Binding MusicFiles, Mode=TwoWay, Delay=333, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="1">
                <!--Mode=TwoWay, Delay=333,-->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="Black" Margin="5" Padding="5">
                            <Grid x:Name="ItemsGrid">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <!--<ColumnDefinition Width="160" />-->
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.RowSpan="3" Grid.Column="0" VerticalAlignment="Center">
                                    <Label Content="Select" HorizontalAlignment="Center" />
                                    <CheckBox x:Name="ItemSelected" HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>


                                <Grid x:Name="ID3TopGrid" Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,0,5">
                                        <TextBlock Text="Artist: " />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsScrollInertiaEnabled="True"> <!-- CanContentScroll="True" -->
                                            <ListBox x:Name="Listbox_Id3Artists" ItemsSource="{Binding Id3Artists}" MinHeight="18" />
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,0,5">
                                        <TextBlock Text="Title: " />
                                        <!--<TextBox Text="{Binding ID3Title}" MinHeight="18"/>-->
                                        <TextBox x:Name="TextBox_Id3Title" Text="{Binding Id3Title, Delay=333, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="5,0,0,5">
                                        <TextBlock Text="Album: " />
                                        <TextBox x:Name="TextBox_Id3Album" Text="{Binding Id3Album}" MinHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="5,0,0,5">
                                        <TextBlock Text="Genre: " />
                                        <TextBox x:Name="TextBox_Id3GenresAsString"
                                            Text="{Binding Id3GenresAsString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MinHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Margin="5,0,0,5">
                                        <TextBlock Text="ReleaseYear: " />
                                        <TextBox x:Name="TextBox_Id3ReleaseYear" Text="{Binding Id3ReleaseYear}" MinHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" Margin="5,0,0,5">
                                        <TextBlock Text="Comment: " />
                                        <TextBox x:Name="TextBox_Id3Comment" Text="{Binding Id3Comment}" MinHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" Margin="5,0,0,5">
                                        <TextBlock Text="Bitrate: " />
                                        <TextBox x:Name="TextBox_Bitrate" Text="{Binding Bitrate}" MinHeight="18" IsReadOnly="True" />
                                    </StackPanel>

                                </Grid>


                                <TextBox x:Name="TextBox_FileName" Grid.Row="1" Grid.Column="1" Text="{Binding FileName}" Margin="0,0,0,5" MinHeight="18" />

                                <Button x:Name="Btn_ID3ToFile" Grid.Row="0" Grid.Column="2" Margin="5,16,0,5" Command="{ReflectionBinding DataContext.FileNameFromId3Command, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="10,4,-15,0" FontSize="13">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                            <Run Text="↷" />
                                        </TextBlock>
                                        <TextBlock Text="From ID3 to Filename" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="Btn_FileToID3" Grid.Row="1" Grid.Column="2" Margin="5,0,0,5" Command="{ReflectionBinding DataContext.Id3FromFileNameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="10,4,-15,0" FontSize="13">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                            <Run Text="↶" />
                                        </TextBlock>
                                        <TextBlock Text="From Filename to ID3" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="Btn_Reset" Grid.Row="2" Grid.Column="2" Content="Reset ID3 to default" Margin="5,0,0,5" Command="{ReflectionBinding DataContext.ResetId3ToDefaultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding }" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </TabItem>
</UserControl>