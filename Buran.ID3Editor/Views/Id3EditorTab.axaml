<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Buran.ID3Editor.Views.Id3EditorTab"
             xmlns:vm="using:Buran.ID3Editor.ViewModels"
             xmlns:types="clr-namespace:Buran.Types;assembly=Buran.Types"
             xmlns:models="using:Buran.ID3Editor.Models"
             xmlns:loc="using:Buran.Localization"
             x:DataType="vm:Id3EditorTabViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <types:ArtistRemoveArgsConverter x:Key="ArtistRemoveArgsConverter" />
        <types:GenreRemoveArgsConverter x:Key="GenreRemoveArgsConverter" />
        <types:MoodRemoveArgsConverter x:Key="MoodRemoveArgsConverter" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:Id3EditorTabViewModel />
    </UserControl.DataContext>

    <Design.DataContext>
        <vm:Id3EditorTabViewModel />
    </Design.DataContext>

    <Grid x:Name="Id3EditorGrid" RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" Classes="toolbar" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{loc:Loc Key=Id3.Folder}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedPath}" Classes="path" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="{Binding EditToggleLabel}"
                            Command="{Binding ToggleEditModeCommand}"
                            Classes.accent="{Binding IsEditMode}"
                            ToolTip.Tip="{loc:Loc Key=Id3.EditTagsTip}" />
                    <Button Content="{loc:Loc Key=Id3.Columns}" ToolTip.Tip="{loc:Loc Key=Id3.ColumnsTip}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ItemsControl Width="220" ItemsSource="{Binding ColumnOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackColumnOption">
                                            <CheckBox Margin="4" Content="{Binding Header}"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Text="{Binding SelectedFilesCountText}" VerticalAlignment="Center" />
                    <Button Content="{loc:Loc Key=Id3.All}"
                            Command="{Binding SelectAllFilesCommand}"
                            IsEnabled="{Binding HasMusicFiles}"
                            ToolTip.Tip="{loc:Loc Key=Id3.SelectAllTip}" />
                    <Button Content="{loc:Loc Key=Id3.None}"
                            Command="{Binding UnselectAllFilesCommand}"
                            IsEnabled="{Binding HasSelectedFiles}"
                            ToolTip.Tip="{loc:Loc Key=Id3.UnselectAllTip}" />
                    <Button Content="{loc:Loc Key=Id3.Play}"
                            Command="{Binding PlaySelectedCommand}"
                            IsVisible="{Binding HasPlayerModule}"
                            IsEnabled="{Binding HasSelectedFiles}"
                            ToolTip.Tip="{loc:Loc Key=Id3.PlayTip}" />
                    <Button Content="{loc:Loc Key=Id3.AddToPlaylist}"
                            Command="{Binding AddSelectedToPlaylistCommand}"
                            IsVisible="{Binding HasPlayerModule}"
                            IsEnabled="{Binding HasSelectedFiles}"
                            ToolTip.Tip="{loc:Loc Key=Id3.AddToPlaylistTip}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="toolbar" Margin="0,0,0,4"
                IsVisible="{Binding ShowBulkBar}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{loc:Loc Key=Common.Artists}"
                        Command="{Binding OpenBulkAddDialogCommand}"
                        CommandParameter="Artist"
                        ToolTip.Tip="{loc:Loc Key=Id3.ArtistsTip}" />
                <Button Content="{loc:Loc Key=Common.Genres}"
                        Command="{Binding OpenBulkAddDialogCommand}"
                        CommandParameter="Genre"
                        ToolTip.Tip="{loc:Loc Key=Id3.GenresTip}" />
                <Button Content="{loc:Loc Key=Common.Moods}"
                        Command="{Binding OpenBulkAddDialogCommand}"
                        CommandParameter="Mood"
                        ToolTip.Tip="{loc:Loc Key=Id3.MoodsTip}" />
                <Button Content="{loc:Loc Key=Id3.Comments}"
                        Command="{Binding OpenBulkCommentsDialogCommand}"
                        ToolTip.Tip="{loc:Loc Key=Id3.CommentsTip}" />
                <Button Content="{loc:Loc Key=Id3.FileNameFromId3}"
                        Command="{Binding BulkFileNameFromId3Command}"
                        ToolTip.Tip="{loc:Loc Key=Id3.FileNameFromId3Tip}" />
                <Button Content="{loc:Loc Key=Id3.Id3FromFileName}"
                        Command="{Binding BulkId3FromFileNameCommand}"
                        ToolTip.Tip="{loc:Loc Key=Id3.Id3FromFileNameTip}" />
            </StackPanel>
        </Border>

        <Grid x:Name="EditorSplitGrid" Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2" IsVisible="{Binding HasFilterCaption}">
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="{loc:Loc Key=Id3.ClearFilter}"
                            Command="{Binding ClearFilterCommand}" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="muted" Text="{Binding FilterCaption}" />
                        <TextBlock Classes="muted" Text="{Binding IndexNotice}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasIndexNotice}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="TracksGrid" Classes="editor-list"
                          IsVisible="{Binding HasMusicFiles}"
                          ItemsSource="{Binding MusicFiles}"
                          SelectedItem="{Binding FocusedFile}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          DoubleTapped="Tracks_DoubleTapped"
                          ContextRequested="Tracks_ContextRequested">
                    <DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Loc Key=Id3.OpenFolder}"
                                      Command="{Binding OpenContainingFolderCommand}"
                                      ToolTip.Tip="{loc:Loc Key=Id3.OpenFolderTip}" />
                        </MenuFlyout>
                    </DataGrid.ContextFlyout>
                </DataGrid>
            </DockPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding !HasMusicFiles}">
                    <TextBlock Text="{loc:Loc Key=Id3.NoFolderLoaded}" Classes="empty-title" Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Width="280" TextAlignment="Center"
                               Text="{loc:Loc Key=Id3.NoFolderHint}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="InspectorPane" Grid.Column="1"
                  Width="{Binding InspectorPaneWidth}" MinWidth="200"
                  IsVisible="{Binding IsEditMode}" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#3A4F70" Cursor="SizeWestEast"
                        PointerPressed="InspectorSplitter_PointerPressed"
                        PointerMoved="InspectorSplitter_PointerMoved"
                        PointerReleased="InspectorSplitter_PointerReleased"
                        PointerCaptureLost="InspectorSplitter_PointerCaptureLost" />
                <Border Grid.Column="1" Classes="toolbar" Padding="8,6">
                <Panel>
                    <ScrollViewer IsVisible="{Binding FocusedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="6" DataContext="{Binding FocusedFile}"
                                    x:DataType="types:Mp3FileObject">
                            <Grid ColumnDefinitions="108,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="4">
                                <TextBlock Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.FocusedTrack}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{loc:Loc Key=Id3.FocusedTrack}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold"
                                           Text="{Binding Id3Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.Title}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Id3Title}" />

                                <TextBlock Grid.Row="2" Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.Album}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Id3Album}" />

                                <TextBlock Grid.Row="3" Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.ReleaseYear}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{loc:Loc Key=Id3.ReleaseYear}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Id3ReleaseYear}" />

                                <TextBlock Grid.Row="4" Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.Comment}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Id3Comment}" />

                                <TextBlock Grid.Row="5" Classes="muted" VerticalAlignment="Center"
                                           Text="{loc:Loc Key=Id3.Filename}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{loc:Loc Key=Id3.Filename}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FileName}" IsReadOnly="True" />
                            </Grid>

                            <TextBlock Classes="muted" Text="{loc:Loc Key=Id3.Artists}" />
                            <ItemsControl ItemsSource="{Binding Id3ArtistCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="X" Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).RemoveSingleArtistFromID3TagsCommand}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ArtistRemoveArgsConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <AutoCompleteBox PlaceholderText="{loc:Loc Key=Id3.ArtistName}"
                                                 FilterMode="ContainsOrdinal"
                                                 MinimumPrefixLength="1"
                                                 MaxDropDownHeight="200"
                                                 Text="{Binding ArtistToAdd, Mode=TwoWay}"
                                                 ItemsSource="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).KnownArtistNames}"
                                                 Tag="Artist"
                                                 KeyDown="CatalogAddBox_KeyDown" />
                                <Button Grid.Column="1" Content="+" Margin="5,0,0,0"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).AddSingleArtistFromID3TagsCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                            <TextBlock Classes="muted" Text="{loc:Loc Key=Id3.Genre}" />
                            <ItemsControl ItemsSource="{Binding Id3GenreCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="X" Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).RemoveSingleGenreFromID3TagsCommand}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource GenreRemoveArgsConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <AutoCompleteBox PlaceholderText="{loc:Loc Key=Id3.GenreName}"
                                                 FilterMode="ContainsOrdinal"
                                                 MinimumPrefixLength="1"
                                                 MaxDropDownHeight="200"
                                                 Text="{Binding GenreToAdd, Mode=TwoWay}"
                                                 ItemsSource="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).KnownGenreNames}"
                                                 Tag="Genre"
                                                 KeyDown="CatalogAddBox_KeyDown" />
                                <Button Grid.Column="1" Content="+" Margin="5,0,0,0"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).AddSingleGenreFromID3TagsCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                            <TextBlock Classes="muted" Text="{loc:Loc Key=Id3.Moods}" />
                            <ItemsControl ItemsSource="{Binding Id3MoodCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="X" Margin="8,0,0,0"
                                                    Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).RemoveSingleMoodFromID3TagsCommand}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MoodRemoveArgsConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto">
                                <AutoCompleteBox PlaceholderText="{loc:Loc Key=Id3.MoodName}"
                                                 FilterMode="ContainsOrdinal"
                                                 MinimumPrefixLength="1"
                                                 MaxDropDownHeight="200"
                                                 Text="{Binding MoodToAdd, Mode=TwoWay}"
                                                 ItemsSource="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).KnownMoodNames}"
                                                 Tag="Mood"
                                                 KeyDown="CatalogAddBox_KeyDown" />
                                <Button Grid.Column="1" Content="+" Margin="5,0,0,0"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).AddSingleMoodFromID3TagsCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                            <WrapPanel Margin="0,4,0,0">
                                <Button Margin="0,0,4,4"
                                        Content="{loc:Loc Key=Id3.FromId3ToFilenameShort}"
                                        ToolTip.Tip="{loc:Loc Key=Id3.FromId3ToFilename}"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).FileNameFromId3Command}"
                                        CommandParameter="{Binding}" />
                                <Button Margin="0,0,4,4"
                                        Content="{loc:Loc Key=Id3.FromFilenameToId3Short}"
                                        ToolTip.Tip="{loc:Loc Key=Id3.FromFilenameToId3}"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).Id3FromFileNameCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Margin="0,0,4,4"
                                        Content="{loc:Loc Key=Id3.ResetId3Short}"
                                        ToolTip.Tip="{loc:Loc Key=Id3.ResetId3}"
                                        Command="{Binding $parent[UserControl].((vm:Id3EditorTabViewModel)DataContext).ResetId3ToDefaultCommand}"
                                        CommandParameter="{Binding}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Text="{loc:Loc Key=Id3.NoTrackSelected}"
                               IsVisible="{Binding FocusedFile, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
